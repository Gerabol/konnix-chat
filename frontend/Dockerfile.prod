# ==========================================
# Stage 1: Build Frontend (Node.js 22)
# ==========================================
FROM node:22-alpine AS build
WORKDIR /app

# Copia dependências e instala de forma determinística
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps

# Copia código-fonte e compila para produção
COPY . .
RUN npm run build

# ==========================================
# Stage 2: Runtime Nginx Web Server (Alpine)
# ==========================================
FROM nginx:1.27-alpine
WORKDIR /usr/share/nginx/html

# Remove arquivos padrões do Nginx
RUN rm -rf ./*

# Copia o bundle gerado pelo Vite
COPY --from=build /app/dist .

# Copia a configuração otimizada do Nginx (SPA + Proxy API + WebSocket)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expõe portas HTTP (80 padrão e 5173 para compatibilidade de rotas Cloudflare)
EXPOSE 80 5173

# Healthcheck interno do Nginx
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
