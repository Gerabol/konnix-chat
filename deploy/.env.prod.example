# ==============================================================================
# CONFIGURAÇÕES DO AMBIENTE DE PRODUÇÃO (PROD) - KONNIX CHAT
# ==============================================================================

# Portas de Acesso no Host Local
PROD_FRONTEND_PORT=80
PROD_BACKEND_PORT=8080

# Banco de Dados PostgreSQL Produção (OBRIGATÓRIO DEFINIR SENHA FORTE)
POSTGRES_USER=konnix
POSTGRES_PASSWORD=
POSTGRES_DB=konnix_prod

# Administrador Inicial do Sistema (Criado na primeira inicialização)
KONNIX_ADMIN_USERNAME=admin
KONNIX_ADMIN_NAME=Administrador do Sistema
KONNIX_ADMIN_EMAIL=
KONNIX_ADMIN_PASSWORD=

# Notificações Push Web (VAPID)
# Gerar par de chaves VAPID (ex: via npx web-push generate-vapid-keys)
KONNIX_VAPID_PUBLIC_KEY=
KONNIX_VAPID_PRIVATE_KEY=
KONNIX_VAPID_SUBJECT=mailto:admin@seudominio.com.br

# Cloudflare Tunnel Token
# Token obtido em Cloudflare Zero Trust -> Networks -> Tunnels
CLOUDFLARE_PROD_TUNNEL_TOKEN=
