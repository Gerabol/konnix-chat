# ==============================================================================
# CONFIGURAÇÕES DO AMBIENTE DE HOMOLOGAÇÃO (STAGING) - KONNIX CHAT
# ==============================================================================

# Portas de Acesso no Host Local
STAGING_FRONTEND_PORT=5175
STAGING_BACKEND_PORT=8082

# Banco de Dados PostgreSQL Staging (OBRIGATÓRIO DEFINIR SENHA)
POSTGRES_USER=konnix
POSTGRES_PASSWORD=
POSTGRES_DB=konnix_staging

# Administrador Inicial do Sistema
KONNIX_ADMIN_USERNAME=admin
KONNIX_ADMIN_NAME=Administrador Homologação
KONNIX_ADMIN_EMAIL=admin-homolog@konnix.local
KONNIX_ADMIN_PASSWORD=

# Notificações Push Web (VAPID)
# Gere suas chaves se desejar testar push em homologação:
KONNIX_VAPID_PUBLIC_KEY=
KONNIX_VAPID_PRIVATE_KEY=
KONNIX_VAPID_SUBJECT=mailto:homolog@konnix.local

# Cloudflare Tunnel Token (Opcional)
# Se vazio, iniciará o Quick Tunnel gratuito da Cloudflare (URL gerada nos logs do container).
# Se preenchido com o token do Cloudflare Zero Trust, conectará diretamente ao seu domínio personalizado.
CLOUDFLARE_STAGING_TUNNEL_TOKEN=
