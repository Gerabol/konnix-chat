# Exemplo de configuração — Konnix Chat
# Copie para .env (na raiz do projeto) e preencha com valores reais.
# NUNCA comite o .env real.

# Credenciais do banco (defaults do docker-compose)
POSTGRES_USER=konnix
POSTGRES_PASSWORD=konnix
POSTGRES_DB=konnix

# Bootstrap do primeiro administrador (aplicado apenas se o usuário não existir)
KONNIX_ADMIN_USERNAME=admin
KONNIX_ADMIN_NAME=Administrador
KONNIX_ADMIN_EMAIL=admin@konnix.local
# TROQUE por uma senha forte e única. Não deixe vazio em produção.
KONNIX_ADMIN_PASSWORD=admin-senha-123

# Web Push VAPID (obrigatório para notificações push reais).
# Gere um par de chaves P-256 base64url e preencha abaixo. A chave privada NUNCA vai para o frontend.
# Exemplos de geração com Node.js: npx web-push generate-vapid-keys --json
# Se deixar vazio, o backend gera chaves em memória (efêmeras, sem persistência).
KONNIX_VAPID_PUBLIC_KEY=
KONNIX_VAPID_PRIVATE_KEY=
KONNIX_VAPID_SUBJECT=mailto:contato@exemplo.gov.br
